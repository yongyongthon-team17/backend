# prod 프로파일이 읽는 환경 변수 (값은 비워 둠). 실제 값은 .env 또는 배포 환경에 설정하고 커밋하지 않는다.
SPRING_PROFILES_ACTIVE=prod
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# AI 개선안(A04). 값은 비워 둔다. 없으면 서버는 정상 기동하고 AI 제안만 LLM_UNAVAILABLE로 응답한다.
OPENAI_API_KEY=
# 아래 4개는 선택. 비우면(줄을 지우면) application*.yaml 값을 쓴다(prod 기본: gpt-6.1-terra, low, 2000, false).
# 모델·추론 수준을 바꾸면 기존 AI 캐시는 다음 요청에서 재생성된다(CACHE_INVALIDATED). 사용 가능 모델: gpt-6-luna, gpt-6.1-terra, gpt-6.1-sol
# APP_LLM_MODEL=gpt-6.1-sol
# APP_LLM_REASONING_EFFORT=low
# 응답 최대 토큰(추론 토큰 포함). medium 이상이면 4000 권장
# APP_LLM_MAX_OUTPUT_TOKENS=2000
# true면 부족한 점이 없는 시설도 AI 일반 보완 제안을 만든다(AI 호출 증가). 기본 false
# APP_ANALYSIS_GENERAL_SUGGESTION_ENABLED=false
# CORS 허용 출처(쉼표 구분, 정확한 출처만, * 금지). 비우면 교차 출처를 허용하지 않는다.
CORS_ALLOWED_ORIGINS=
