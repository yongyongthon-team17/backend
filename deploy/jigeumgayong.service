[Unit]
Description=Jigeumgayong backend
After=network.target postgresql.service

[Service]
User=ubuntu
WorkingDirectory=/opt/jigeumgayong
# SPRING_PROFILES_ACTIVE, DB_URL, DB_USERNAME, DB_PASSWORD, OPENAI_API_KEY, CORS_ALLOWED_ORIGINS 는
# 이 파일에 적지 않고 서버의 환경 파일에서만 읽는다. (권한 600)
EnvironmentFile=/etc/jigeumgayong/env
ExecStart=/usr/bin/java -jar /opt/jigeumgayong/app.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
